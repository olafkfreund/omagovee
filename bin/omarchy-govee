#!/usr/bin/env python3
"""Control Govee lights from the Omarchy desktop.

# omarchy:summary=Control Govee lights (LAN if reachable, cloud otherwise)
# omarchy:args=scan|list|on|off|toggle|brightness N|color HEX|state [device]
# omarchy:examples=omarchy-govee toggle | omarchy-govee color ff8800 desk

Two transports, picked per device:
  LAN   — UDP, instant, no rate limit, needs "LAN Control" enabled per device
          in the Govee Home app. Found by `scan`, cached with the device MAC.
  cloud — https://openapi.api.govee.com, needs an API key, works for every
          model. 120 control req/min/device.

Stdlib only on purpose: this runs from a bar widget click, so it must start
fast and never depend on jq/curl being installed.
"""

import concurrent.futures
import fcntl
import functools
import tempfile
import threading
import json
import os
import re
import socket
import struct
import sys
import time
import urllib.error
import urllib.request

API = "https://openapi.api.govee.com"
CONFIG = os.path.expanduser(os.environ.get("OMAGOVEE_CONFIG", "~/.config/omagovee"))
CACHE = os.path.expanduser(os.environ.get("OMAGOVEE_CACHE", "~/.cache/omagovee"))
MCAST, PORT_REQ, PORT_RX, PORT_CMD = "239.255.255.250", 4001, 4002, 4003

COLORS = {
    "red": 0xFF0000, "green": 0x00FF00, "blue": 0x0000FF, "white": 0xFFFFFF,
    "warm": 0xFF9329, "cool": 0xCCE0FF, "orange": 0xFF8800, "purple": 0x8000FF,
    "pink": 0xFF40A0, "yellow": 0xFFDD00,
}


# --- payload builders (pure, covered by test_omagovee.py) -------------------

def cloud_payload(sku, mac, ctype, instance, value, req_id="omagovee"):
    return {
        "requestId": req_id,
        "payload": {
            "sku": sku,
            "device": mac,
            "capability": {"type": ctype, "instance": instance, "value": value},
        },
    }


def lan_payload(cmd, data):
    return {"msg": {"cmd": cmd, "data": data}}


def parse_color(spec):
    """'ff8800', '#ff8800' or a name -> 24-bit int. Raises ValueError."""
    if not isinstance(spec, str):
        raise ValueError("colour must be a name or RRGGBB")
    if spec.lower() in COLORS:
        return COLORS[spec.lower()]
    if not re.fullmatch(r"#?[0-9a-fA-F]{6}", spec):
        raise ValueError("colour must be RRGGBB or #RRGGBB")
    value = int(spec.lstrip("#"), 16)
    return value


def rgb(value):
    return {"r": value >> 16 & 0xFF, "g": value >> 8 & 0xFF, "b": value & 0xFF}


# --- small helpers ----------------------------------------------------------

def die(msg, code=1):
    raise GoveeError(msg, code)


class GoveeError(Exception):
    def __init__(self, message, code=1):
        super().__init__(message)
        self.code = code


_LOCKS = {}
_LOCKS_GUARD = threading.Lock()


def locked(path_fn):
    """Serialize threads and processes; nested operations reuse the outer lock."""
    def decorate(fn):
        @functools.wraps(fn)
        def wrapped(*args, **kwargs):
            path = path_fn()
            with _LOCKS_GUARD:
                lock, local = _LOCKS.setdefault(path, (threading.RLock(), threading.local()))
            with lock:
                if getattr(local, "held", False):
                    return fn(*args, **kwargs)
                os.makedirs(os.path.dirname(path), exist_ok=True)
                with open(path, "a") as fh:
                    fcntl.flock(fh, fcntl.LOCK_EX)
                    local.held = True
                    try:
                        return fn(*args, **kwargs)
                    finally:
                        local.held = False
        return wrapped
    return decorate


# ponytail: one LAN exchange at a time; use a shared receiver if latency matters.
def lan_lock_path():
    return os.path.join(os.environ.get("XDG_RUNTIME_DIR", tempfile.gettempdir()),
                        "omagovee-%s" % os.getuid(), "lan.lock")


def config_lock_path():
    return os.path.join(CONFIG, ".lock")


def read_json(path, default=None):
    try:
        with open(path) as fh:
            value = json.load(fh)
    except FileNotFoundError:
        return default
    except (OSError, ValueError) as exc:
        die("Cannot read %s: %s" % (path, exc))
    if not isinstance(value, dict):
        die("Expected a JSON object in %s" % path)
    return value


def write_json(path, obj):
    os.makedirs(os.path.dirname(path), exist_ok=True)
    tmp = None
    try:
        with tempfile.NamedTemporaryFile(mode="w", dir=os.path.dirname(path),
                                         delete=False) as fh:
            tmp = fh.name
            json.dump(obj, fh, indent=2)
            fh.flush()
            os.fsync(fh.fileno())
        os.replace(tmp, path)
    finally:
        if tmp and os.path.exists(tmp):
            os.unlink(tmp)


def api_key():
    key = os.environ.get("GOVEE_API_KEY")
    if key:
        return key.strip()
    try:
        with open(os.path.join(CONFIG, "api-key")) as fh:
            return fh.read().strip()
    except OSError:
        die("No API key. Govee Home app -> Profile -> settings -> Apply for API\n"
            "Key, then: mkdir -p %s && echo KEY > %s/api-key" % (CONFIG, CONFIG))


def local_ip():
    """Source address for the LAN we're on, so multicast leaves the right NIC
    rather than a docker bridge — which is exactly how a scan silently finds
    nothing on a machine with containers."""
    override = os.environ.get("OMAGOVEE_IFACE_IP")
    if override:
        return override
    sock = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
    try:
        sock.connect(("8.8.8.8", 53))  # no packet sent, just picks a route
        return sock.getsockname()[0]
    finally:
        sock.close()


# --- LAN transport ----------------------------------------------------------

def lan_socket(bind_ip):
    rx = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
    tx = None
    try:
        tx = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
        rx.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
        rx.bind(("0.0.0.0", PORT_RX))
        rx.setsockopt(
            socket.IPPROTO_IP, socket.IP_ADD_MEMBERSHIP,
            struct.pack("4s4s", socket.inet_aton(MCAST), socket.inet_aton(bind_ip)))
        rx.settimeout(0.5)

        tx.setsockopt(socket.SOL_SOCKET, socket.SO_BROADCAST, 1)
        tx.setsockopt(socket.IPPROTO_IP, socket.IP_MULTICAST_IF, socket.inet_aton(bind_ip))
        tx.setsockopt(socket.IPPROTO_IP, socket.IP_MULTICAST_TTL, 4)
        tx.bind((bind_ip, 0))
        return rx, tx
    except BaseException:
        rx.close()
        if tx is not None:
            tx.close()
        raise


@locked(lan_lock_path)
def lan_scan(timeout=5.0, sweep=True):
    """Discover LAN-enabled devices. Returns {mac: {sku, ip, ...}}."""
    bind_ip = local_ip()
    rx, tx = lan_socket(bind_ip)
    try:
        msg = json.dumps(lan_payload("scan", {"account_topic": "reserve"})).encode()
        targets = [MCAST, bind_ip.rsplit(".", 1)[0] + ".255"]
        if sweep:
            # ponytail: 254 unicast packets, because consumer routers drop
            # multicast far more often than they drop plain UDP. Drop the sweep
            # if you ever run this on a /16.
            targets += ["%s.%d" % (bind_ip.rsplit(".", 1)[0], i) for i in range(1, 255)]
        for target in targets:
            try:
                tx.sendto(msg, (target, PORT_REQ))
            except OSError:
                pass

        found, end = {}, time.monotonic() + timeout
        while time.monotonic() < end:
            try:
                raw, addr = rx.recvfrom(4096)
            except socket.timeout:
                continue
            try:
                data = json.loads(raw)["msg"]["data"]
            except (ValueError, KeyError, TypeError):
                continue
            if not isinstance(data, dict) or not isinstance(data.get("device"), str):
                continue
            data["ip"] = addr[0]
            found[data["device"]] = data
        return found
    finally:
        rx.close()
        tx.close()


def lan_send(ip, cmd, data):
    sock = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
    try:
        sock.sendto(json.dumps(lan_payload(cmd, data)).encode(), (ip, PORT_CMD))
    finally:
        sock.close()


@locked(lan_lock_path)
def lan_state(ip, timeout=1.5):
    """devStatus round-trip. None if the device doesn't answer in time — the
    caller must fall back rather than treat silence as 'off'."""
    try:
        rx, tx = lan_socket(local_ip())
    except OSError:
        return None
    try:
        tx.sendto(json.dumps(lan_payload("devStatus", {})).encode(), (ip, PORT_CMD))
        end = time.monotonic() + timeout
        while time.monotonic() < end:
            try:
                raw, addr = rx.recvfrom(4096)
            except socket.timeout:
                continue
            if addr[0] != ip:
                continue
            try:
                msg = json.loads(raw)["msg"]
                if isinstance(msg, dict) and msg.get("cmd") == "devStatus" and isinstance(msg.get("data"), dict):
                    return msg["data"]
            except (ValueError, KeyError, TypeError):
                continue
        return None
    finally:
        rx.close()
        tx.close()


# --- cloud transport --------------------------------------------------------

def cloud(path, body=None):
    req = urllib.request.Request(
        API + path,
        data=json.dumps(body).encode() if body is not None else None,
        headers={"Govee-API-Key": api_key(), "Content-Type": "application/json"},
        method="POST" if body is not None else "GET")
    try:
        with urllib.request.urlopen(req, timeout=10) as resp:
            body = json.load(resp)
        # Govee answers a rejected command with HTTP 200 and code 400 in the
        # body. Trusting the status line makes every failure look like a win.
        if not isinstance(body, dict):
            die("Govee returned a malformed response")
        if body.get("code") != 200:
            die("Govee: %s (code %s)" % (body.get("msg", "?"), body.get("code")))
        return body
    except urllib.error.HTTPError as exc:
        die("Govee API %s: %s" % (exc.code, exc.read().decode()[:200]))
    except urllib.error.URLError as exc:
        die("Govee API unreachable: %s" % exc.reason)


def cloud_devices(max_age=86400):
    """Cached device list — the list endpoint allows only 30 req/min/account,
    and a bar widget must not spend that budget on redraws."""
    path = os.path.join(CACHE, "devices.json")
    cached = read_json(path)
    if cached and type(cached.get("fetched")) not in (int, float):
        die("Malformed device cache timestamp")
    if cached and time.time() - cached.get("fetched", 0) < max_age:
        if not isinstance(cached.get("devices"), list):
            die("Malformed cached device inventory")
        return cached["devices"]
    devices = cloud("/router/api/v1/user/devices").get("data", [])
    write_json(path, {"fetched": time.time(), "devices": devices})
    return devices


# --- device resolution ------------------------------------------------------

def devices():
    """Cloud devices annotated with a LAN ip where scan found one."""
    lan = read_json(os.path.join(CACHE, "lan.json"), {}) or {}
    out = []
    inventory = cloud_devices()
    if not isinstance(inventory, list):
        die("Malformed device inventory")
    for dev in inventory:
        if not isinstance(dev, dict) or any(not isinstance(dev.get(k), str) or not dev[k] for k in ("sku", "device")):
            die("Malformed device inventory entry")
        if dev.get("deviceName") is not None and not isinstance(dev["deviceName"], str):
            die("Malformed device name")
        if not isinstance(dev.get("capabilities", []), list):
            die("Malformed device capabilities")
        entry = {
            "sku": dev.get("sku"),
            "mac": dev.get("device"),
            "name": dev.get("deviceName") or dev.get("sku"),
            "ip": None,
            "capabilities": dev.get("capabilities", []),
        }
        hit = lan.get(entry["mac"])
        if hit:
            if not isinstance(hit, dict) or not isinstance(hit.get("ip"), str):
                die("Malformed LAN cache entry")
            try:
                socket.inet_aton(hit["ip"])
            except OSError:
                die("Invalid LAN cache IP address")
            entry["ip"] = hit["ip"]
        out.append(entry)
    return out


def resolve(name=None):
    devs = devices()
    if not devs:
        die("No devices on the account. Check the API key.")
    if name is None:
        name = read_json(os.path.join(CONFIG, "default.json"), {}).get("name")
    if name is None:
        if len(devs) == 1:
            return devs[0]
        die("Several devices — name one, or set a default:\n  %s"
            % "\n  ".join(d["name"] for d in devs))
    if not isinstance(name, str):
        die("Device identifier must be a string")
    want = name.strip().lower()
    if not want:
        die("Empty device name.")  # "" is a substring of every name
    for dev in devs:
        if want == (dev["mac"] or "").lower():
            return dev
    labels = load_labels()
    # Exact before substring: `lvrt1` is inside `lvrt10`, and taking the first
    # substring hit moved whichever came first in the account list.
    exact = [d for d in devs
             if want in ((d["name"] or "").lower(), (d["mac"] or "").lower(),
                         labels.get(d["mac"], labels.get(d["name"], "")).lower())]
    if len(exact) > 1:
        die("Ambiguous device %r; use a MAC: %s" % (name, ", ".join(d["mac"] for d in exact)))
    if exact:
        return exact[0]
    matches = [d for d in devs
               if want in (d["name"] or "").lower()
               or want in labels.get(d["mac"], labels.get(d["name"], "")).lower()]
    if len(matches) > 1:
        die("%r matches several devices: %s — use the full name"
            % (name, ", ".join(d["name"] for d in matches)))
    if not matches:
        die("No device matching %r. Known: %s"
            % (name, ", ".join(d["name"] for d in devs)))
    return matches[0]


# --- rooms and scenes -------------------------------------------------------

def rooms_path():
    return os.path.join(CONFIG, "rooms.json")


RESERVED_ROOMS = ("none", "other", "all")


def check_room_name(name):
    """`none` means no room, `other` is the panel's heading for unassigned
    devices and `all` is a target keyword: a room with one of those names
    could never be reached."""
    name = name.strip()
    if not name or name.lower() in RESERVED_ROOMS:
        die("Not a usable room name: %r (reserved: %s)"
            % (name, ", ".join(RESERVED_ROOMS)))
    return name


def load_rooms():
    """A device in two rooms (older CLIs could write that) keeps the first
    room it appears in. Repaired in memory only: `dump` reads this every
    minute from the bar and a read must never write the file."""
    seen, rooms = set(), {}
    for room, names in (read_json(rooms_path(), {}) or {}).items():
        check_room_name(room)
        if not isinstance(names, list) or any(not isinstance(n, str) or not n for n in names):
            die("Room %r must contain a list of device IDs or names" % room)
        kept = [n for n in dict.fromkeys(names) if n not in seen]
        seen.update(kept)
        if kept:
            rooms[room] = kept
    return rooms


def canonical_rooms(rooms):
    seen, result = set(), {}
    for room, members in rooms.items():
        ids = list(dict.fromkeys(resolve(n)["mac"] for n in members))
        kept = [mac for mac in ids if mac not in seen]
        seen.update(kept)
        if kept:
            result[room] = kept
    return result


@locked(config_lock_path)
def migrate_ids():
    """Explicit migration: validate all references before writing any files."""
    import copy
    rooms = canonical_rooms(load_rooms())
    old_labels = load_labels()
    labels = {resolve(n)["mac"]: label for n, label in old_labels.items()}
    labels.update({d["mac"]: old_labels[d["mac"]] for d in devices() if d["mac"] in old_labels})
    default = read_json(os.path.join(CONFIG, "default.json"), {})
    if default.get("name"):
        default = {"name": resolve(default["name"])["mac"]}
    scenes = copy.deepcopy(load_scenes())
    for name, steps in scenes.items():
        scene_plan(name)
        for step in steps:
            target = step.get("target", "all")
            if target != "all" and not target.startswith("room:"):
                step["target"] = resolve(target)["mac"]
    for path, data in ((rooms_path(), rooms), (labels_path(), labels),
                       (os.path.join(CONFIG, "default.json"), default), (scenes_path(), scenes)):
        if os.path.exists(path):
            backup = path + ".before-ids"
            if not os.path.exists(backup):
                with open(backup, "x") as fh:
                    json.dump(read_json(path), fh, indent=2)
        write_json(path, data)


def auto_rooms(devs):
    """Group by the leading alphabetic run of the name: shelf1/shelf2 -> shelf,
    lvrt1..lvrt4 -> lvrt. Wrong sometimes; it is a starting point the user
    edits, not a guess we act on silently."""
    groups = {}
    for dev in devs:
        match = re.match(r"[a-zA-Z]+", dev["name"] or "")
        if match and match.group(0).lower() not in RESERVED_ROOMS:
            groups.setdefault(match.group(0).lower(), []).append(dev["name"])
    return {k: v for k, v in groups.items() if len(v) > 1}


# Govee publishes no SKU -> product-type mapping: the API reports every light
# as `devices.types.light` with identical capabilities whether it is a bulb, a
# strip or a floor lamp, so the form factor can only come from the model
# number. Longest prefix wins. Anything unlisted is drawn as a bulb; to correct
# one, put {"H6072": "lamp"} in ~/.config/omagovee/icons.json rather than
# editing this table.
KINDS = {
    "H61": "strip",    # H615A and the rest of the LED strip line
    "H70": "string",   # string / outdoor lights
    "H6072": "lamp", "H6076": "lamp", "H6078": "lamp",  # floor lamps
    "H60": "bulb",     # H600C, H600D and the bulb family
    "H14": "bulb",     # H14C0 Edison bulb
}


def device_kind(sku):
    sku = sku or ""
    overrides = read_json(os.path.join(CONFIG, "icons.json"), {}) or {}
    if any(v not in ("bulb", "strip", "lamp", "string") for v in overrides.values()):
        die("Unknown device icon kind in icons.json")
    if sku in overrides:
        return overrides[sku]
    for prefix in sorted(KINDS, key=len, reverse=True):
        if sku.startswith(prefix):
            return KINDS[prefix]
    return "bulb"


def labels_path():
    return os.path.join(CONFIG, "labels.json")


def load_labels():
    """{MAC: friendly name}; legacy device-name keys remain readable."""
    labels = read_json(labels_path(), {})
    if any(not isinstance(v, str) for v in labels.values()):
        die("Labels must be strings")
    return labels


@locked(config_lock_path)
def set_label(name, text):
    labels = load_labels()
    dev = resolve(name)
    # Remove the old name-keyed label too, so clearing a migrated label stays clear.
    if dev["name"] in labels and sum(d["name"] == dev["name"] for d in devices()) == 1:
        labels.pop(dev["name"], None)
    name = dev["mac"]
    if text or dev["name"] in labels:
        labels[name] = text
    else:
        labels.pop(name, None)
    write_json(labels_path(), labels)
    return labels


@locked(config_lock_path)
def assign_room(room, names, rooms=None):
    """Move devices into `room`, or out of every room when room is 'none'.
    A device lives in one room: leaving it in two makes `room:` targets fire
    twice and the panel draw it twice."""
    names = list(dict.fromkeys(names))
    rooms = load_rooms() if rooms is None else rooms
    for key in list(rooms):
        rooms[key] = [n for n in rooms[key] if n not in names]
        if not rooms[key]:
            del rooms[key]
    if room != "none":
        room = check_room_name(room)
        rooms.setdefault(room, []).extend(names)
    write_json(rooms_path(), rooms)
    return rooms


def scenes_path():
    return os.path.join(CONFIG, "scenes.json")


DEFAULT_SCENES = {
    "meeting": [{"target": "all", "power": 1, "color": "red", "brightness": 60}],
    "focus":   [{"target": "all", "power": 1, "color": "cool", "brightness": 100}],
    "evening": [{"target": "all", "power": 1, "color": "warm", "brightness": 35}],
    "off":     [{"target": "all", "power": 0}],
}


def load_scenes():
    scenes = read_json(scenes_path())
    return dict(DEFAULT_SCENES) if scenes is None else scenes


def resolve_many(target):
    """A device name, `room:<name>`, or `all` -> list of devices."""
    devs = devices()
    if target == "all":
        if not devs:
            die("No devices on the account")
        return devs
    if target == "room:other":
        assigned = {mac for members in canonical_rooms(load_rooms()).values() for mac in members}
        unassigned = [d for d in devs if d["mac"] not in assigned]
        if not unassigned:
            die("No unassigned devices")
        return unassigned
    if target.startswith("room:"):
        names = load_rooms().get(target[5:], [])
        if not names:
            die("No room %r. Known: %s" % (target[5:], ", ".join(load_rooms()) or "none"))
        members = [resolve(n) for n in names]
        return list({d["mac"]: d for d in members}.values())
    return [resolve(target)]


def scene_plan(name):
    scenes = load_scenes()
    if name not in scenes:
        die("No scene %r. Known: %s" % (name, ", ".join(sorted(scenes))))
    steps = scenes[name]
    if not isinstance(steps, list) or not steps:
        die("Scene must contain at least one step")
    plan = []
    for step in steps:
        if not isinstance(step, dict) or set(step) - {"target", "power", "brightness", "color"}:
            die("Invalid scene step")
        target = step.get("target", "all")
        if not isinstance(target, str) or not target.strip():
            die("Scene target must be a nonempty string")
        actions = []
        for kind in ("power", "brightness", "color"):
            if kind in step:
                value = parse_color(step[kind]) if kind == "color" and isinstance(step[kind], str) else step[kind]
                validate_value(kind, value)
                actions.append((kind, value))
        if not actions:
            die("Scene step has no actions")
        for dev in resolve_many(target):
            for kind, value in actions:
                if step.get("power") == 0 and kind != "power":
                    continue
                plan.append((dev, kind, value))
    return plan


def run_scene(name):
    return execute(scene_plan(name))


def validate_value(kind, value):
    maximum = {"power": 1, "brightness": 100, "color": 0xFFFFFF}.get(kind)
    if maximum is None or type(value) is not int or not 0 <= value <= maximum:
        die("Invalid %s value: %r" % (kind, value))


def execute(plan):
    results = []
    for dev, kind, value in plan:
        validate_value(kind, value)
    for dev, kind, value in plan:
        try:
            result = apply(dev, kind, value)
        except (GoveeError, OSError, ValueError) as exc:
            result = {"device": dev["mac"], "kind": kind, "requested": value,
                      "status": "failed", "transport": "cloud", "error": str(exc)}
        results.append(result)
    return {"ok": all(r["status"] != "failed" for r in results), "results": results}


# --- actions ----------------------------------------------------------------

def apply(dev, kind, value):
    """kind: power|brightness|color. LAN when we know an ip, cloud otherwise."""
    validate_value(kind, value)
    lan_cmd = {
        "power": ("turn", {"value": value}),
        "brightness": ("brightness", {"value": value}),
        "color": ("colorwc", {"color": rgb(value), "colorTemInKelvin": 0}),
    }[kind]
    cloud_cap = {
        "power": ("devices.capabilities.on_off", "powerSwitch"),
        "brightness": ("devices.capabilities.range", "brightness"),
        "color": ("devices.capabilities.color_setting", "colorRgb"),
    }[kind]

    result = {"device": dev["mac"], "kind": kind, "requested": value}
    if dev["ip"]:
        try:
            observed = lan_apply(dev["ip"], lan_cmd, kind, value)
        except OSError:
            observed = None
        if observed is not None:
            return dict(result, transport="lan", status="confirmed", observed=observed)
        result["lan_error"] = "LAN read-back did not confirm the requested value"
    ctype, instance = cloud_cap
    cloud("/router/api/v1/device/control",
          cloud_payload(dev["sku"], dev["mac"], ctype, instance, value,
                        req_id="omagovee-%s" % time.time_ns()))
    # Cloud acknowledgement is not proof that the physical lamp changed.
    return dict(result, transport="cloud", status="unverified")


@locked(lan_lock_path)
def lan_apply(ip, command, kind, value):
    expected = rgb(value) if kind == "color" else value
    for attempt in range(2):
        try:
            lan_send(ip, *command)
            time.sleep(0.4)
            status = lan_state(ip)
        except OSError:
            status = None
        if status:
            got = status.get({"power": "onOff", "brightness": "brightness", "color": "color"}[kind])
            if got == expected:
                return got
    return None


def power_state(dev):
    """{"online": bool, "power": 0|1|None}. `power` is meaningless when the
    device is offline — the cloud keeps serving its last known value."""
    if dev["ip"]:
        try:
            data = lan_state(dev["ip"])
        except OSError:
            data = None
        if data and "onOff" in data:
            return {"online": True, "power": int(data["onOff"]),
                    "brightness": data.get("brightness"), "color": data.get("color"),
                    "transport": "lan"}
    resp = cloud("/router/api/v1/device/state",
                 {"requestId": "omagovee", "payload":
                  {"sku": dev["sku"], "device": dev["mac"]}})
    out = {"online": None, "power": None, "brightness": None, "color": None,
           "transport": "cloud"}
    payload = resp.get("payload")
    if not isinstance(payload, dict) or not isinstance(payload.get("capabilities"), list):
        die("Malformed cloud state response")
    for cap in payload["capabilities"]:
        if not isinstance(cap, dict) or not isinstance(cap.get("state"), dict):
            die("Malformed cloud state capability")
        instance, value = cap.get("instance"), cap["state"].get("value")
        if instance == "online":
            if type(value) not in (bool, int) or value not in (0, 1):
                die("Invalid cloud reachability value")
            out["online"] = bool(value)
        elif instance in ("powerSwitch", "brightness", "colorRgb"):
            key = {"powerSwitch": "power", "brightness": "brightness", "colorRgb": "color"}[instance]
            validate_value(key, value)
            out[key] = rgb(value) if key == "color" else value
    if out["online"] is None:
        out["error"] = "Cloud response did not report reachability"
    if out["online"] is False:
        out.update(power=None, brightness=None, color=None)
    return out


def dump():
    """Everything the panel draws, as one JSON document.

    Cloud reads are concurrent; LAN exchanges share the protocol reply port
    and are serialized by lan_state()."""
    devs = devices()

    labels = load_labels()

    def annotate(dev):
        entry = dict(dev)
        entry["label"] = labels.get(dev["mac"], labels.get(dev["name"], ""))
        entry["kind"] = device_kind(dev["sku"])
        try:
            state = power_state(dev)
            entry.update(state)
        except (GoveeError, OSError, ValueError) as exc:
            entry.update(online=None, power=None, brightness=None, color=None, error=str(exc))
        return entry

    with concurrent.futures.ThreadPoolExecutor(max_workers=8) as pool:
        annotated = list(pool.map(annotate, devs))

    return {
        "devices": annotated,
        "rooms": load_rooms(),
        "scenes": sorted(load_scenes()),
        "default": read_json(os.path.join(CONFIG, "default.json"), {}).get("name"),
    }


# --- cli --------------------------------------------------------------------

USAGE = __doc__.split("\n\n")[0] + """
  omarchy-govee scan                 discover LAN-enabled devices
  omarchy-govee list                 devices on the account (LAN ip if known)
  omarchy-govee on|off|toggle [dev]
  omarchy-govee brightness 0-100 [dev]
  omarchy-govee color HEX|name [dev]   %s
  omarchy-govee state [dev]
  omarchy-govee default <dev>        remember which device bare commands hit
  omarchy-govee rooms [--auto | <room> <dev>... |
                       assign <room|none> <dev>... | rename <old> <new>]
  omarchy-govee label <dev> [friendly name]   cosmetic name for the panel
  omarchy-govee scene [name]         run a scene, or list them
  omarchy-govee dump                 JSON of everything, for the panel

  State/on/off/brightness/color targets accept a MAC, name, room:<name> or all.
  toggle accepts a single device.
  --json list|scenes|state TARGET|on TARGET|off TARGET|brightness N TARGET|color HEX TARGET|scene NAME
  migrate-ids                     migrate stored device names to MACs (with backups)
""" % "|".join(sorted(COLORS))


@locked(config_lock_path)
def edit_config(argv):
    return main(argv, config_locked=True)


def main(argv, config_locked=False):
    if not argv or argv[0] in ("-h", "--help", "help"):
        print(USAGE)
        return 0
    cmd, args = argv[0], argv[1:]
    if cmd in ("rooms", "label", "default") and args and not config_locked:
        return edit_config(argv)
    if cmd == "--json":
        result = json_command(args)
        print(json.dumps(result))
        return 0 if result.get("ok", True) else 1

    if cmd == "migrate-ids" and not args:
        migrate_ids()
        print("Migrated device references to MACs; originals saved as *.before-ids")
        return 0

    if cmd == "scan":
        found = lan_scan()
        write_json(os.path.join(CACHE, "lan.json"), found)
        if not found:
            print("No LAN-enabled Govee devices answered.\n"
                  "Enable 'LAN Control' per device in the Govee Home app; models\n"
                  "without that toggle are cloud-only and still work via `list`.")
            return 1
        for mac, dev in sorted(found.items()):
            print("%-18s %-8s %s" % (dev.get("ip"), dev.get("sku", "?"), mac))
        return 0

    if cmd == "list":
        for dev in devices():
            print("%-24s %-8s %-20s %s"
                  % (dev["name"], dev["sku"], dev["ip"] or "cloud", dev["mac"]))
        return 0

    if cmd == "default":
        if not args:
            die("usage: omarchy-govee default <device>")
        dev = resolve(args[0])
        write_json(os.path.join(CONFIG, "default.json"), {"name": dev["mac"]})
        print("default: %s" % dev["name"])
        return 0

    if cmd in ("on", "off"):
        value = 1 if cmd == "on" else 0
        return report(execute([(d, "power", value) for d in
                               (resolve_many(args[0]) if args else [resolve()])]))

    if cmd == "toggle":
        dev = resolve(args[0] if args else None)
        current = power_state(dev)
        if not current["online"]:
            die("%s is offline — check its power and Wi-Fi" % dev["name"])
        if current["power"] is None:
            die("Could not read state of %s" % dev["name"])
        return report(execute([(dev, "power", 0 if current["power"] else 1)]))

    if cmd == "brightness":
        if not args:
            die("usage: omarchy-govee brightness 0-100 [device]")
        value = int(args[0])
        if not 0 <= value <= 100:
            die("brightness must be 0-100")
        return report(execute([(d, "brightness", value) for d in
                               (resolve_many(args[1]) if len(args) > 1 else [resolve()])]))

    if cmd == "color":
        if not args:
            die("usage: omarchy-govee color HEX|name [device]")
        try:
            value = parse_color(args[0])
        except ValueError:
            die("bad colour %r — use RRGGBB or one of: %s"
                % (args[0], ", ".join(sorted(COLORS))))
        return report(execute([(d, "color", value) for d in
                               (resolve_many(args[1]) if len(args) > 1 else [resolve()])]))

    if cmd == "dump":
        print(json.dumps(dump(), indent=2))
        return 0

    if cmd == "scene":
        if not args:
            print("\n".join(sorted(load_scenes())))
            return 0
        return report(run_scene(args[0]))

    if cmd == "label":
        if not args:
            die("usage: omarchy-govee label <device> [friendly name]")
        dev = resolve(args[0])
        labels = set_label(dev["mac"], " ".join(args[1:]).strip())
        print("%s: %s" % (dev["name"], labels.get(dev["name"], "(no label)")))
        return 0

    if cmd == "rooms":
        current = load_rooms()
        if args and args[0] == "rename":
            if len(args) != 3:
                die("usage: omarchy-govee rooms rename <old> <new>")
            if args[1] not in current:
                die("No room %r. Known: %s" % (args[1], ", ".join(current) or "none"))
            new = check_room_name(args[2])
            if new in current:
                die("room %r already exists — move its lights with 'rooms assign'"
                    % new)
            current = canonical_rooms(current)
            current[new] = current.pop(args[1])
            write_json(rooms_path(), current)
        elif args and args[0] == "--auto":
            current = canonical_rooms(auto_rooms(devices()))
            write_json(rooms_path(), current)
        elif args:
            # `rooms <room> <dev>...` is `rooms assign`: it used to replace the
            # member list without removing the devices from their old rooms.
            target = args[1:] if args[0] == "assign" else args
            if len(target) < 2:
                die("usage: omarchy-govee rooms [assign] <room|none> <device>...")
            # Name first, so a bad one fails before any device lookup hits the API.
            room = target[0] if target[0] == "none" else check_room_name(target[0])
            ids = [resolve(n)["mac"] for n in target[1:]]
            canonical = canonical_rooms(current)
            current = assign_room(room, ids, canonical)
        for room, members in sorted(current.items()):
            print("%-12s %s" % (room, " ".join(members)))
        return 0

    if cmd == "state":
        failed = False
        for dev in (resolve_many(args[0]) if args else [resolve()]):
            try:
                current = power_state(dev)
                state = {None: "unknown", 0: "off", 1: "on"}.get(current["power"], "unknown")
                if current["online"] is not True:
                    state = "offline" if current["online"] is False else "unknown"
                    failed = True
                print("%s: %s" % (dev["name"], state))
            except (GoveeError, OSError, ValueError) as exc:
                print("%s: %s" % (dev["name"], exc), file=sys.stderr)
                failed = True
        return int(failed)

    die("unknown command %r\n\n%s" % (cmd, USAGE), 2)


def report(result):
    for item in result["results"]:
        if item["status"] != "confirmed":
            print("%s: %s%s" % (item["device"], item["status"],
                                ": " + item["error"] if "error" in item else " (cloud accepted; not read back)"),
                  file=sys.stderr)
    return 0 if result["ok"] else 1


def json_command(args):
    if not args:
        die("Expected a JSON command")
    cmd, args = args[0], args[1:]
    if cmd == "list" and not args:
        return {"devices": devices(), "rooms": load_rooms(), "labels": load_labels()}
    if cmd == "scenes" and not args:
        scenes = load_scenes()
        return {"scenes": scenes}
    if cmd == "scene" and len(args) == 1:
        return run_scene(args[0])
    if cmd == "state" and len(args) == 1:
        results = []
        for dev in resolve_many(args[0]):
            try:
                results.append(dict(device=dev["mac"], **power_state(dev)))
            except (GoveeError, OSError, ValueError) as exc:
                results.append({"device": dev["mac"], "online": None, "error": str(exc)})
        return {"ok": all("error" not in r for r in results), "devices": results}
    if cmd in ("on", "off") and len(args) == 1:
        kind, value, target = "power", int(cmd == "on"), args[0]
    elif cmd in ("brightness", "color") and len(args) == 2:
        kind, target = cmd, args[1]
        value = parse_color(args[0]) if cmd == "color" else int(args[0])
    else:
        die("Invalid JSON command or arguments")
    validate_value(kind, value)
    return execute([(d, kind, value) for d in resolve_many(target)])


if __name__ == "__main__":
    try:
        sys.exit(main(sys.argv[1:]))
    except BrokenPipeError:
        sys.exit(0)
    except (GoveeError, OSError, ValueError) as exc:
        if sys.argv[1:2] == ["--json"]:
            print(json.dumps({"ok": False, "error": str(exc)}))
        else:
            print(str(exc), file=sys.stderr)
        sys.exit(getattr(exc, "code", 1))
    except KeyboardInterrupt:
        sys.exit(130)
